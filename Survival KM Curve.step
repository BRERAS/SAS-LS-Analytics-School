rsion":2,"type":"code","flowMetadata":{"inputPorts":[{"name":"Dataset","displayName":"Dataset","localDisplayName":"Dataset","minEntries":1,"maxEntries":1,"defaultEntries":0,"type":"table"}],"outputPorts":[]},"ui":"{\n\t\"showPageContentOnly\": true,\n\t\"pages\": [\n\t\t{\n\t\t\t\"id\": \"page1\",\n\t\t\t\"type\": \"page\",\n\t\t\t\"label\": \"Page 1\",\n\t\t\t\"children\": [\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"Dataset\",\n\t\t\t\t\t\"type\": \"inputtable\",\n\t\t\t\t\t\"label\": \"Select Dataset\",\n\t\t\t\t\t\"required\": true,\n\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"Time\",\n\t\t\t\t\t\"type\": \"columnselector\",\n\t\t\t\t\t\"label\": \"Select Time Variable\",\n\t\t\t\t\t\"order\": false,\n\t\t\t\t\t\"columntype\": \"n\",\n\t\t\t\t\t\"max\": 1,\n\t\t\t\t\t\"min\": 1,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"table\": \"Dataset\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"Status\",\n\t\t\t\t\t\"type\": \"columnselector\",\n\t\t\t\t\t\"label\": \"Select Status Variable\",\n\t\t\t\t\t\"order\": false,\n\t\t\t\t\t\"columntype\": \"a\",\n\t\t\t\t\t\"max\": 1,\n\t\t\t\t\t\"min\": 1,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"table\": \"Dataset\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"CenVal\",\n\t\t\t\t\t\"type\": \"dropdown\",\n\t\t\t\t\t\"label\": \"Select Censored Value\",\n\t\t\t\t\t\"items\": {\n\t\t\t\t\t\t\"ref\": \"Status\"\n\t\t\t\t\t},\n\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"strata\",\n\t\t\t\t\t\"type\": \"columnselector\",\n\t\t\t\t\t\"label\": \"Select Group Variable\",\n\t\t\t\t\t\"order\": false,\n\t\t\t\t\t\"columntype\": \"a\",\n\t\t\t\t\t\"max\": 1,\n\t\t\t\t\t\"min\": 1,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"table\": \"Dataset\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"TimeType\",\n\t\t\t\t\t\"type\": \"dropdown\",\n\t\t\t\t\t\"label\": \"Enter the units of Time\",\n\t\t\t\t\t\"items\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"value\": \"Days\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"value\": \"Months\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"value\": \"Years\"\n\t\t\t\t\t\t}\n\t\t\t\t\t],\n\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t}\n\t\t\t]\n\t\t}\n\t],\n\t\"syntaxversion\": \"1.3.0\",\n\t\"values\": {\n\t\t\"Dataset\": {\n\t\t\t\"library\": \"\",\n\t\t\t\"table\": \"\"\n\t\t},\n\t\t\"Time\": [],\n\t\t\"Status\": [],\n\t\t\"CenVal\": null,\n\t\t\"strata\": [],\n\t\t\"TimeType\": null\n\t},\n\t\"columnExclusions\": [\n\t\t[\n\t\t\t\"Status\",\n\t\t\t\"Time\"\n\t\t],\n\t\t[\n\t\t\t\"strata\",\n\t\t\t\"Status\"\n\t\t],\n\t\t[\n\t\t\t\"strata\",\n\t\t\t\"Time\"\n\t\t]\n\t]\n}","templates":{"SAS":"/* SAS templated code goes here */\n\n\n\nods noproctitle;\nods graphics / imagemap=on;\n\n\n/* Run the Lifetest to get the output */\nproc lifetest data = &Dataset outsurv = surv_est;\n  time &Time * &Status(&CenVal);\n  strata &strata;\nrun;\n\n\n/* get values for filling in missing last censored data*/\n\nproc sql;\ncreate table last as \nselect stratum, min(Survival) as last\nfrom surv_est\ngroup by stratum;\nquit;\n\n\nPROC SQL;\ncreate table Surv as \nselect E.*\n      ,L.last\nfrom surv_est as E left join last as L\n  on E.stratum = L.stratum\norder by stratum, &Time;\nquit;\n\n/* Create the table to make the VA graphics  */\n\ndata SurvPlot;\nset Surv;\n  Time = put(&Time,6.);\n  Censored = put(_Censor_,1.);\n  Group = &strata;\n  if survival = . then Survival_prob = last;  else survival_prob = Survival;\n  if censored = \"1\" then censor_prob = survival_prob;\n  label Group = \"Treatment Group (&strata)\"\n        Censored = \"Censored\"\n        Survival_Prob = \"Survival Probability\"\n        Time = \"Survival Time (&TimeType)\"\n        censor_prob = \"Censor Probability\";\nrun;\n\n/* Upload graphic table to VA */\n\n%MACRO Move_to_CAS (saslib,sasname,caslib,casname);\nproc casutil;\n\tdroptable casdata=\"&casname\" incaslib=\"&caslib\" quiet;\n\tload data=&saslib..&sasname outcaslib=\"&caslib\"\n\tcasout=\"&casname\" replace;\n    promote incaslib=\"&caslib\" casdata=\"&casname\" outcaslib=\"&caslib\";\nrun;\n\n%MEND;\n\n%Move_to_CAS(work,SurvPlot,public,Survival_Plot);"}}